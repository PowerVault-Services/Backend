# Force LF line endings for all text files (prevents CRLF issues on Windows→macOS)
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.node binary
*.dll binary
*.so binary
*.dylib binary
