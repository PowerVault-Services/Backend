# === Database ===
DATABASE_URL="postgresql://admin:password123@localhost:5433/solar_db?schema=public"

# === Auth ===
JWT_SECRET="your-jwt-secret"

# === Huawei FusionSolar API ===
HUAWEI_API_BASE_URL="https://intl.fusionsolar.huawei.com"
HUAWEI_USER=""
HUAWEI_PASSWORD=""

HUAWEI_ALARM_USER=""
HUAWEI_ALARM_PASSWORD=""

HUAWEI_ONDEMAND_USER=""
HUAWEI_ONDEMAND_PASSWORD=""

HUAWEI_BACKUP_USER=""
HUAWEI_BACKUP_PASSWORD=""

HUAWEI_API_DEBUG=1

# alarm tuning
HUAWEI_ALARM_LOOKBACK_DAYS=30
HUAWEI_ALARM_STALE_MS=900000

# cron schedule
HUAWEI_ALARM_CRON="*/5 * * * *"
HUAWEI_ALARM_SYNC_CRON="*/10 * * * *"
HUAWEI_ALARM_LOOKBACK_DAYS=400
HUAWEI_ALARM_STALE_MS=600000

HUAWEI_MIN_INTERVAL_MS=6500
HUAWEI_RATE_LIMIT_BACKOFF_MS=2000
HUAWEI_RATE_LIMIT_MAX_RETRIES=3
HUAWEI_ASSET_SYNC_COOLDOWN_MS=600000
HUAWEI_MAX_PLANTS_PER_TICK=1
HUAWEI_DEV_BATCH_SIZE=100
HUAWEI_STATION_CACHE_TTL_MS=21600000

PRISMA_CLIENT_PATH=./generated/prisma

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PowerVault Service <noreply@example.com>"

# === Storage ===
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=uploads
STORAGE_PUBLIC_BASE=/uploads

# MinIO (optional - set STORAGE_DRIVER=minio to use)
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=solar-files
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_REGION=us-east-1
MINIO_KEEP_LOCAL_COPY=false
READ_FROM_OBJECT_STORAGE=false
WRITE_TO_OBJECT_STORAGE=false
FALLBACK_TO_DISK=true
