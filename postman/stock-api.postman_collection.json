    {
      "name": "4) List Pages",
      "item": [
        {
          "name": "GET All Stock Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('summary payload is valid', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(Array.isArray(json.data.list)).to.eql(true);",
                  "  pm.expect(json.data.pagination).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{stock_base}}/summary?page=1&pageSize=20&productId={{productId}}"
