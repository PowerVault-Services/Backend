@startuml ERD_Forecast_Energy
!define primary_key(x) <b><u>x</u></b>
!define foreign_key(x) <i>x</i>
!define not_null(x) <b>x</b>

hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #FEFECE
  BorderColor #A80036
  ArrowColor #A80036
}

title Solar O&M — Forecast & Energy Production

entity "Site" as site {
  primary_key(id) : INT <<PK>>
  --
  not_null(name) : VARCHAR
  not_null(plantCode) : VARCHAR <<unique>>
}

entity "SiteForecastMonthly" as fcm {
  primary_key(id) : INT <<PK>>
  --
  foreign_key(siteId) : INT <<FK>>
  not_null(month) : INT
  globalKwhM2 : FLOAT
  eGridKwh : FLOAT
  prRatio : FLOAT
  ..
  <<unique>> (siteId, month)
}

entity "SiteForecastYearly" as fcy {
  primary_key(id) : INT <<PK>>
  --
  foreign_key(siteId) : INT <<FK>>
  not_null(year) : INT
  degradationPct : FLOAT
  annualProductionKwh : FLOAT
  warrantyEnergyOutputKwh : FLOAT
  ..
  <<unique>> (siteId, year)
}

entity "SiteMonthlyActual" as actual {
  primary_key(id) : INT <<PK>>
  --
  foreign_key(siteId) : INT <<FK>>
  not_null(plantCode) : VARCHAR
  not_null(year) : INT
  not_null(month) : INT
  not_null(key) : VARCHAR
  production : FLOAT
  pr : FLOAT
  revenue : FLOAT
  ..
  <<unique>> (siteId, year, month)
}

' Relationships
site ||--o{ fcm : "forecasts"
site ||--o{ fcy : "forecasts"
site ||--o{ actual : "actuals"

@enduml
