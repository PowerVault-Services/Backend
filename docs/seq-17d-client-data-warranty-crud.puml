@startuml Client Data - Warranty CRUD (Supplier & Customer)
hide footbox
skinparam sequenceMessageAlign center

actor User
participant "Frontend" as FE
participant "ClientData\nController" as Ctrl
participant "Prisma\n(WarrantySupplier\nItem)" as SupDB
participant "Prisma\n(WarrantyCustomer\nItem)" as CusDB

== Create Supplier Warranty Item ==

User -> FE : Add supplier warranty item
activate User
activate FE

FE -> Ctrl : POST /api/client-data/projects/:siteId\n/warranty/supplier\n{category, itemName, supplierName,\nproductName, quantity,\nstartWarranty, endWarranty, warrantyYears}
activate Ctrl

Ctrl -> SupDB : create({siteId, category,\nitemName, supplierName,\nproductName, quantity,\nstartWarranty, endWarranty,\nwarrantyYears})
activate SupDB
SupDB --> Ctrl : supplierItem
deactivate SupDB

Ctrl --> FE : 200 {supplierItem}
deactivate Ctrl

FE --> User : Supplier item created
deactivate FE
deactivate User

== Update Supplier Warranty Item ==

User -> FE : Edit supplier warranty item
activate User
activate FE

FE -> Ctrl : PUT /api/client-data/warranty/supplier/:itemId\n{category?, itemName?, supplierName?, ...}
activate Ctrl

Ctrl -> SupDB : update({where: {id: itemId},\ndata: {partial fields}})
activate SupDB
SupDB --> Ctrl : updatedItem
deactivate SupDB

Ctrl --> FE : 200 {updatedItem}
deactivate Ctrl

FE --> User : Supplier item updated
deactivate FE
deactivate User

== Delete Supplier Warranty Item ==

User -> FE : Delete supplier warranty item
activate User
activate FE

FE -> Ctrl : DELETE /api/client-data/warranty/supplier/:itemId
activate Ctrl

Ctrl -> SupDB : delete({where: {id: itemId}})
activate SupDB
SupDB --> Ctrl : OK
deactivate SupDB

Ctrl --> FE : 200 {success: true}
deactivate Ctrl

FE --> User : Supplier item deleted
deactivate FE
deactivate User

== Create Customer Warranty Item ==

User -> FE : Add customer warranty item
activate User
activate FE

FE -> Ctrl : POST /api/client-data/projects/:siteId\n/warranty/customer\n{category, itemName, warrantyYears}
activate Ctrl

Ctrl -> CusDB : create({siteId, category,\nitemName, warrantyYears})
activate CusDB
CusDB --> Ctrl : customerItem
deactivate CusDB

Ctrl --> FE : 200 {customerItem}
deactivate Ctrl

FE --> User : Customer item created
deactivate FE
deactivate User

== Update Customer Warranty Item ==

User -> FE : Edit customer warranty item
activate User
activate FE

FE -> Ctrl : PUT /api/client-data/warranty/customer/:itemId\n{category?, itemName?, warrantyYears?}
activate Ctrl

Ctrl -> CusDB : update({where: {id: itemId},\ndata: {partial fields}})
activate CusDB
CusDB --> Ctrl : updatedItem
deactivate CusDB

Ctrl --> FE : 200 {updatedItem}
deactivate Ctrl

FE --> User : Customer item updated
deactivate FE
deactivate User

== Delete Customer Warranty Item ==

User -> FE : Delete customer warranty item
activate User
activate FE

FE -> Ctrl : DELETE /api/client-data/warranty/customer/:itemId
activate Ctrl

Ctrl -> CusDB : delete({where: {id: itemId}})
activate CusDB
CusDB --> Ctrl : OK
deactivate CusDB

Ctrl --> FE : 200 {success: true}
deactivate Ctrl

FE --> User : Customer item deleted
deactivate FE
deactivate User

@enduml
