@startuml Client Data - Project CRUD (Create / Update / Delete)
hide footbox
skinparam sequenceMessageAlign center

actor User
participant "Frontend" as FE
participant "ClientData\nController" as Ctrl
participant "Prisma\n(Site)" as SiteDB
participant "Prisma\n(SiteForecast\nMonthly)" as ForecastDB

== Create Project ==

User -> FE : Fill new project form
activate User
activate FE

FE -> Ctrl : POST /api/client-data/thailand/projects\n{plantCode, name, capacityKWp,\naddress, warrantyStart, warrantyEnd,\npanelBrand, inverterBrand, ...}
activate Ctrl

Ctrl -> SiteDB : create({plantCode, name,\ncapacityKWp, address, latitude,\nlongitude, projectStatus, ...})
activate SiteDB
SiteDB --> Ctrl : site {id, plantCode, name, ...}
deactivate SiteDB

alt forecastRows provided in body
    Ctrl -> Ctrl : upsertForecastMonthlyRowsInternal\n(siteId, rows)
    activate Ctrl

    Ctrl -> ForecastDB : $transaction(\nupsert x12 months)
    activate ForecastDB
    ForecastDB --> Ctrl : OK
    deactivate ForecastDB

    Ctrl --> Ctrl : done
    deactivate Ctrl
else no forecastRows - generate defaults
    Ctrl -> Ctrl : ensureDefaultForecastRows\n(siteId, warrantyStart)
    activate Ctrl

    Ctrl -> ForecastDB : count({where: {siteId}})
    activate ForecastDB
    ForecastDB --> Ctrl : 0
    deactivate ForecastDB

    Ctrl -> ForecastDB : $transaction(\ncreate x12 default months)
    activate ForecastDB
    ForecastDB --> Ctrl : OK
    deactivate ForecastDB

    Ctrl --> Ctrl : done
    deactivate Ctrl
end

Ctrl --> FE : 200 {siteId, projectNo, projectName,\nsystemSizeKWp, endWarranty, status}
deactivate Ctrl

FE --> User : Project created
deactivate FE
deactivate User

== Update Project ==

User -> FE : Edit project fields
activate User
activate FE

FE -> Ctrl : PUT /api/client-data/thailand/projects/:siteId\n{name?, capacityKWp?, warrantyEnd?, ...}
activate Ctrl

Ctrl -> SiteDB : update({where: {id: siteId},\ndata: {partial fields}})
activate SiteDB
SiteDB --> Ctrl : updatedSite
deactivate SiteDB

opt forecastRows provided
    Ctrl -> ForecastDB : $transaction(\nupsert x12 months)
    activate ForecastDB
    ForecastDB --> Ctrl : OK
    deactivate ForecastDB
end

Ctrl --> FE : 200 {siteId, projectNo, projectName,\nsystemSizeKWp, endWarranty, status}
deactivate Ctrl

FE --> User : Project updated
deactivate FE
deactivate User

== Delete Project ==

User -> FE : Click delete project
activate User
activate FE

FE -> Ctrl : DELETE /api/client-data/thailand/projects/:siteId
activate Ctrl

Ctrl -> SiteDB : delete({where: {id: siteId}})
activate SiteDB
SiteDB --> Ctrl : OK
deactivate SiteDB

Ctrl --> FE : 200 {success: true}
deactivate Ctrl

FE --> User : Project deleted
deactivate FE
deactivate User

@enduml
