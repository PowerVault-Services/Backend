@startuml ERD_Chen_Forecast_Energy
' ============================================================
' Solar O&M — Forecast & Energy Production (Chen Notation)
' ============================================================

top to bottom direction

skinparam defaultFontSize 11
skinparam linetype polyline

skinparam rectangle {
  BackgroundColor #ADD8E6
  BorderColor #000000
  FontStyle bold
}

skinparam hexagon {
  BackgroundColor #F4A460
  BorderColor #000000
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 10
}

' ── Site (ref) ──
rectangle "Site" as E_Site

' ── SiteForecastMonthly ──
rectangle "SiteForecastMonthly" as E_FCM

usecase "<u>//siteId//</u>" as A_FM_sid
usecase "<u>month</u>" as A_FM_m
usecase "globalKwhM2" as A_FM_gk
usecase "eGridKwh" as A_FM_eg
usecase "prRatio" as A_FM_pr

E_FCM -left- A_FM_sid
E_FCM -left- A_FM_m
E_FCM -right- A_FM_gk
E_FCM -right- A_FM_eg
E_FCM -right- A_FM_pr

hexagon "forecasts\n(monthly)" as R_site_fcm
E_Site == "1" R_site_fcm
R_site_fcm == "N" E_FCM

' ── SiteForecastYearly ──
rectangle "SiteForecastYearly" as E_FCY

usecase "<u>//siteId//</u>" as A_FY_sid
usecase "<u>year</u>" as A_FY_y
usecase "degradationPct" as A_FY_dp
usecase "annualProductionKwh" as A_FY_ap
usecase "warrantyEnergyOutputKwh" as A_FY_we

E_FCY -left- A_FY_sid
E_FCY -left- A_FY_y
E_FCY -right- A_FY_dp
E_FCY -right- A_FY_ap
E_FCY -right- A_FY_we

hexagon "forecasts\n(yearly)" as R_site_fcy
E_Site == "1" R_site_fcy
R_site_fcy == "N" E_FCY

' ── SiteMonthlyActual ──
rectangle "SiteMonthlyActual" as E_ACT

usecase "<u>//siteId//</u>" as A_A_sid
usecase "<u>year</u>" as A_A_y
usecase "<u>month</u>" as A_A_m
usecase "plantCode" as A_A_pc
usecase "production" as A_A_prod
usecase "pr" as A_A_pr
usecase "revenue" as A_A_rev

E_ACT -left- A_A_sid
E_ACT -left- A_A_y
E_ACT -left- A_A_m
E_ACT -right- A_A_pc
E_ACT -right- A_A_prod
E_ACT -right- A_A_pr
E_ACT -right- A_A_rev

hexagon "actuals" as R_site_act
E_Site == "1" R_site_act
R_site_act == "N" E_ACT

@enduml
