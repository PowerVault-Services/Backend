@startuml Client Data - Other Tab CRUD
hide footbox
skinparam sequenceMessageAlign center

actor User
participant "Frontend" as FE
participant "ClientData\nController" as Ctrl
participant "Prisma\n(SiteOtherRow)" as OtherDB

== Create Other Row ==

User -> FE : Add new other row
activate User
activate FE

FE -> Ctrl : POST /api/client-data/projects/:siteId/other\n{status, description, remark}
activate Ctrl

Ctrl -> OtherDB : create({siteId, status,\ndescription, remark})
activate OtherDB
OtherDB --> Ctrl : otherRow
deactivate OtherDB

Ctrl --> FE : 200 {otherRow}
deactivate Ctrl

FE --> User : Row created
deactivate FE
deactivate User

== Update Other Row ==

User -> FE : Edit other row
activate User
activate FE

FE -> Ctrl : PUT /api/client-data/other/:rowId\n{status?, description?, remark?}
activate Ctrl

Ctrl -> OtherDB : update({where: {id: rowId},\ndata: {partial fields}})
activate OtherDB
OtherDB --> Ctrl : updatedRow
deactivate OtherDB

Ctrl --> FE : 200 {updatedRow}
deactivate Ctrl

FE --> User : Row updated
deactivate FE
deactivate User

== Delete Other Row ==

User -> FE : Delete other row
activate User
activate FE

FE -> Ctrl : DELETE /api/client-data/other/:rowId
activate Ctrl

Ctrl -> OtherDB : delete({where: {id: rowId}})
activate OtherDB
OtherDB --> Ctrl : OK
deactivate OtherDB

Ctrl --> FE : 200 {success: true}
deactivate Ctrl

FE --> User : Row deleted
deactivate FE
deactivate User

@enduml
